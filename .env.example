# Copy to .env and fill in. Keep .env private (chmod 600) and never commit it.

# --- EZVIZ account (required) ---
EZVIZ_ACCOUNT=you@example.com
EZVIZ_PASSWORD=change-me
# API region host: apiieu.ezvizlife.com (Europe, default); use the host for your account's region.
EZVIZ_REGION=apiieu.ezvizlife.com
# Device serial, as shown in the EZVIZ app (Settings -> Device information) or on the label.
EZVIZ_SERIAL=BXXXXXXXX
# Device encryption password, used to decrypt alarm snapshots. It is the 6-letter verification code
# on the device label, unless you have changed it in the app. Without it you still get motion and
# last_alert, but encrypted pictures cannot be classified.
EZVIZ_VERIFY_CODE=

# --- MQTT broker ---
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USER=ezviz-bridge
# Leave empty for DRY RUN: everything is logged, nothing is published.
MQTT_PASS=
#DISCOVERY_PREFIX=homeassistant
#TOPIC_BASE=ezviz-bridge/<EZVIZ_SERIAL>

# --- Home Assistant device ---
DEVICE_NAME=EZVIZ doorbell
#DEVICE_MODEL=HP3

# --- detection ---
# Doorbell-side detection mode to set at startup: human | pir | image_change | leave
# Keep "leave" so the bridge never overrides the setting chosen in the EZVIZ app.
# Never use pir on the HP3: mode 5 stopped all alarms in testing (no events for ~45 min,
# including a deliberate walk-past).
DETECTION_MODE=leave
DETECT_CONF=0.40
LABELS=person,cat,dog
HOLD_SECONDS=90
# Battery / online / work-mode status poll interval.
POLL_SECONDS=600
#LIVE_CAPTURE_FALLBACK=1
#LIVE_CAPTURE_MAX_PER_HOUR=8
#EVENT_RETENTION_DAYS=7
#MODEL_PATH=/models/yolo11n.onnx
#DATA_DIR=/data

# --- push channel ---
KEEPALIVE=30
LOG_LEVEL=INFO

# --- cloud cross-check (optional; defaults shown) ---
# How often the EZVIZ cloud alarm list is checked for alarms push did not deliver:
# every CLOUD_CHECK_POLL_ONLY_SECONDS while push is down (poll-only mode = the only event source),
# every CLOUD_CHECK_PUSH_SECONDS while push is up. An alarm push has not delivered within
# PUSH_MISS_GRACE_SECONDS is logged as "push missed alarm", handled from the list, and push is re-registered.
#CLOUD_CHECK_POLL_ONLY_SECONDS=60
#CLOUD_CHECK_PUSH_SECONDS=300
#PUSH_MISS_GRACE_SECONDS=120

# --- Uptime Kuma (optional) ---
# Push-monitor URL from Kuma, e.g. http://uptime-kuma:3001/api/push/<your-push-token>
# (copying it with ?status=up&msg=OK&ping= is fine; those params are replaced). Empty = disabled.
KUMA_PUSH_URL=
